# Add these keys to your project's .env, then run devsync from that folder.
# Only DEVSYNC_* keys are read. The file is never uploaded or rewritten.

# ftp | ftps | sftp (choose a protocol supported by your hosting account).
DEVSYNC_TRANSPORT=ftps

# Hostname or IP only, without a URL scheme.
DEVSYNC_HOST=ftp.example.com
DEVSYNC_USERNAME=hosting-user
DEVSYNC_PASSWORD=""

# Optional: defaults to 21 for FTP/FTPS, 22 for SFTP.
DEVSYNC_PORT=

# Leave blank to browse and select an existing server folder during setup.
DEVSYNC_REMOTE_PATH=

# Optional SFTP key path, relative to this project or absolute.
# DEVSYNC_PRIVATE_KEY=~/.ssh/id_ed25519

# Optional behavior.
# DEVSYNC_DRY_RUN=true
# DEVSYNC_DEBOUNCE_MS=400
