# devsync credentials — stored in ~/.devsync/.env, never inside a project.
# That file is created by `devsync init`. Keep it out of version control.

# sftp | ftp | ftps
PROTO=sftp

# Hostname only. Hostinger: ftp.<your-domain>.tld or the SFTP host in your panel.
HOST=ftp.example.com

# 22 for sftp, 21 for ftp/ftps. Leave blank for the protocol default.
PORT=

# FTP/hosting username.
USERNAME=u123456789

# Password, or the passphrase for PRIVATE_KEY_PATH if you use a key.
PASSWORD=

# Optional: SSH key instead of a password (sftp only).
# PRIVATE_KEY_PATH=C:\Users\you\.ssh\id_ed25519

# Connection timeout in ms.
TIMEOUT_MS=20000